       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:purpose [ fhir:v "To declare, in a machine-readable and runnable form, which behaviours a system claiming conformance to the Grouped Document Publisher/Access Provider actor must demonstrate."] ; # 
  fhir:scope ( [
     fhir:reference [
       fhir:v "http://hl7.eu/fhir/health-data-api/ActorDefinition/document-publisher-access-provider-actor-eu-api"^^xsd:anyURI ;
