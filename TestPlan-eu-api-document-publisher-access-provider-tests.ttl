  ] ; # 
  fhir:suite ( [
     fhir:name [ fhir:v "The server declares what the actor requires" ] ;
     fhir:description [ fhir:v "Rule: The server declares what the actor requires — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher-access-provider.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "grp-001 The CapabilityStatement declares DocumentReference and Binary" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-001 (input bindings and expected data). Covers CapabilityStatement.rest.resource.DocumentReference, CapabilityStatement.rest.resource.Binary." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$capability at \"CapabilityStatement.rest.where(mode='server').resource.where(type='DocumentReference').interaction.where(code='search-type').exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$capability at \"CapabilityStatement.rest.where(mode='server').resource.where(type='DocumentReference').interaction.where(code='read').exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$capability at \"CapabilityStatement.rest.where(mode='server').resource.where(type='Binary').interaction.where(code='read').exists()\" should be true" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-002 The CapabilityStatement declares SMART on FHIR security" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-002 (input bindings and expected data). Covers CapabilityStatement.rest.security." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$capability at \"CapabilityStatement.rest.where(mode='server').security.service.coding.where(code='SMART-on-FHIR').exists()\" should be true" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Every transaction requires SMART Backend Services authorization" ] ;
     fhir:description [ fhir:v "Rule: Every transaction requires SMART Backend Services authorization — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher-access-provider.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "grp-003 A request without a token is refused" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-003 (input bindings and expected data). Covers security.authorization." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 401" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-004 A token with no usable scope is refused" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-004 (input bindings and expected data). Covers security.scope." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be one of \"401, 403\"" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Find Document References [ITI-67]" ] ;
     fhir:description [ fhir:v "Rule: Find Document References [ITI-67] — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher-access-provider.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "grp-005 Search by patient returns a searchset of conformant DocumentReferences" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-005 (input bindings and expected data). Covers DocumentReference.search-type." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$found at \"Bundle.type\" should be \"searchset\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$found at \"Bundle.entry.resource.ofType(DocumentReference).exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$found at \"Bundle.entry.resource.ofType(DocumentReference).all(status = 'current' or status = 'superseded' or status = 'entered-in-error')\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$found at \"Bundle.entry.resource.ofType(DocumentReference).all(content.attachment.exists())\" should be true" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-006 Search by EEHRxF priority category" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-006 (input bindings and expected data). Covers DocumentReference.search-type." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byCategory at \"Bundle.type\" should be \"searchset\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byCategory at \"Bundle.entry.resource.ofType(DocumentReference).all(category.coding.where(code='Patient-Summaries').exists())\" should be true" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-007 Search by LOINC document type" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-007 (input bindings and expected data). Covers DocumentReference.search-type." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byType at \"Bundle.type\" should be \"searchset\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byType at \"Bundle.entry.resource.ofType(DocumentReference).all(type.coding.where(system='http://loinc.org' and code='60591-5').exists())\" should be true" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-008 Read a DocumentReference by id" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-008 (input bindings and expected data). Covers DocumentReference.read." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$docRef at \"DocumentReference.id\" should be \"$documentId\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$docRef at \"DocumentReference.subject.exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$docRef at \"DocumentReference.content.attachment.contentType.exists()\" should be true" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-009 An unknown DocumentReference id gives 404 and an OperationOutcome" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-009 (input bindings and expected data). Covers DocumentReference.read." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 404" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$missing at \"OperationOutcome.issue.exists()\" should be true" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Retrieve Document [ITI-68]" ] ;
     fhir:description [ fhir:v "Rule: Retrieve Document [ITI-68] — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher-access-provider.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "grp-010 Read the document content as a Binary" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-010 (input bindings and expected data). Covers Binary.read." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.body should not be empty" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Patient lookup (PDQm ITI-78) is available when the server offers it" ] ;
     fhir:description [ fhir:v "Rule: Patient lookup (PDQm ITI-78) is available when the server offers it — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher-access-provider.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "grp-011 Search Patient by identifier" ] ;
       fhir:description [ fhir:v "Patient is SHOULD on the Access Provider: a server that does not offer it answers 404 or 501 and these scenarios are not applicable to it. A server that does offer it SHALL support all of the search parameters below. Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-011 (input bindings and expected data). Covers Patient.read, Patient.search-type, Patient.search.identifier." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$patients at \"Bundle.type\" should be \"searchset\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$patients at \"Bundle.entry.resource.ofType(Patient).count() >= 1\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$patients at \"Bundle.entry.resource.ofType(Patient).id.distinct().single()\" should be \"$patientId\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$patients should conform to \"http://hl7.org/fhir/StructureDefinition/Bundle\" ignoring slicing errors" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-012 Read Patient by id and conform to patient-eu-core" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-012 (input bindings and expected data). Covers Patient.read, Patient.search.id." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$patient should conform to \"http://hl7.eu/fhir/base/StructureDefinition/patient-eu-core\" ignoring slicing errors" ]
       ] )
     ] [
       fhir:name [ fhir:v "grp-013 Search Patient by demographics the reference patient has" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.grp-013 (input bindings and expected data). Covers Patient.search.family, Patient.search.given, Patient.search.birthdate, Patient.search.gender." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "extract \"/name/0/family\" from $response.body as $family" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "extract \"/gender\" from $response.body as $gender" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byFamily at \"Bundle.entry.resource.ofType(Patient).exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byFamily at \"Bundle.entry.resource.ofType(Patient).id.join(',')\" should contain $patientId" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byGender at \"Bundle.entry.resource.ofType(Patient).exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byGender at \"Bundle.entry.resource.ofType(Patient).id.join(',')\" should contain $patientId" ]
       ] )
     ] )
  ] ) . # 

