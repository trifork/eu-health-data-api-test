     fhir:test ( [
       fhir:name [ fhir:v "pub-006 TLS 1.2 or higher is used for all communications" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.pub-006 (input bindings and expected data). Covers security.tls." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "TLS >= 1.2 — DocumentPublisher confirms each of these is accepted for \"the connection\"" ]
       ] )
     ] )
  ] ) . # 

