  ] ; # 
  fhir:suite ( [
     fhir:name [ fhir:v "SMART Backend Services authorization" ] ;
     fhir:description [ fhir:v "Rule: SMART Backend Services authorization — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "pub-001 The SUT authenticates with a signed JWT client assertion (RFC 7523)" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.pub-001 (input bindings and expected data). Covers security.smart-backend-services." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"POST\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should contain \"grant_type=client_credentials\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should contain \"client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should match \"client_assertion=[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+[.][A-Za-z0-9_-]+([&]|$)\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should contain \"scope=\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "AccessProvider replies to DocumentPublisher with status 200 and:" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Patient lookup [ITI-78]" ] ;
     fhir:description [ fhir:v "Rule: Patient lookup [ITI-78] — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "pub-002 The SUT looks the patient up by identifier with a bearer token" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.pub-002 (input bindings and expected data). Covers Patient.search-type, Patient.search.identifier." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"GET\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/Patient\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"identifier=\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.headers.Authorization should contain \"Bearer\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "AccessProvider replies to DocumentPublisher with status 200 and:" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Simplified Publish [ITI-105]" ] ;
     fhir:description [ fhir:v "Rule: Simplified Publish [ITI-105] — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "pub-003 The SUT creates a DocumentReference with the document embedded" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.pub-003 (input bindings and expected data). Covers DocumentReference.create." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"POST\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/DocumentReference\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.headers.Authorization should contain \"Bearer\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body at \"DocumentReference.resourceType\" should be \"DocumentReference\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body at \"DocumentReference.content.attachment.data.exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body at \"DocumentReference.subject.exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should conform to \"https://profiles.ihe.net/ITI/MHD/StructureDefinition/IHE.MHD.SimplifiedPublish.DocumentReference\" ignoring slicing errors" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "AccessProvider replies to DocumentPublisher with status 201 and:" ]
       ] )
     ] [
       fhir:name [ fhir:v "pub-004 The SUT publishes only the minimal metadata profile it claims" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.pub-004 (input bindings and expected data). Covers DocumentReference.create." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should conform to \"https://profiles.ihe.net/ITI/MHD/StructureDefinition/IHE.MHD.Minimal.DocumentReference\" ignoring slicing errors" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "AccessProvider replies to DocumentPublisher with status 201 and:" ]
       ] )
     ] [
       fhir:name [ fhir:v "pub-005 After a 401 the SUT obtains a fresh token before retrying" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.pub-005 (input bindings and expected data). Covers security.authorization." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"POST\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/DocumentReference\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "AccessProvider replies to DocumentPublisher with status 401 and:" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"POST\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should contain \"grant_type=client_credentials\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should match \"client_assertion=[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+[.][A-Za-z0-9_-]+([&]|$)\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "AccessProvider replies to DocumentPublisher with status 200 and:" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"POST\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/DocumentReference\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.headers.Authorization should contain \"otb-fresh-token\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "AccessProvider replies to DocumentPublisher with status 201 and:" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Transport security" ] ;
     fhir:description [ fhir:v "Rule: Transport security — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-document-publisher.feature" ]
