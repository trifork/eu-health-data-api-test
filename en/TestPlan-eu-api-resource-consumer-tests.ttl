  fhir:description [ fhir:v "Test plan for the **Resource Consumer** actor of [EU Health Data API, 1.0.0-ballot](https://build.fhir.org/ig/euridice-org/eu-health-data-api/).\nThe SUT obtains a token, finds the patient and reads that patient's resources.\nEach `suite` below is a `Rule:` of the Gherkin feature named by `suite.input.file`, and each `suite.test` one of its `Scenario:` lines, matched by the scenario's identifier. The assertions are the scenario's `Then` steps, verbatim.\nThe tests declare which specification obligations they cover (11 requirement paths named by the feature tags).\nFixture prerequisites, input bindings and expected data are in tests/fixtures/provider-v1/manifest.json, keyed by scenario ID. See the Testing page, Fixture contract and expected results. Provider fixtures are R4; client workflows use the canned data embedded in their feature."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:purpose [ fhir:v "To declare, in a machine-readable and runnable form, which behaviours a system claiming conformance to the Resource Consumer actor must demonstrate."] ; # 
  fhir:scope ( [
     fhir:reference [
       fhir:v "http://hl7.eu/fhir/health-data-api/ActorDefinition/resource-consumer-actor-eu-api"^^xsd:anyURI ;
       fhir:l <http://hl7.eu/fhir/health-data-api/ActorDefinition/resource-consumer-actor-eu-api>
     ] ;
     fhir:description [ fhir:v "The Resource Consumer, a client that reads patient resources from a Resource Access Provider, is the system under test. The test bed plays the provider." ]
  ] ) ; # 
  fhir:runner [
     fhir:v "https://www.itb.ec.europa.eu/docs/guides/latest/"^^xsd:anyURI ;
     fhir:l <https://www.itb.ec.europa.eu/docs/guides/latest/>
  ] ; # 
  fhir:suite ( [
     fhir:name [ fhir:v "SMART Backend Services authorization" ] ;
     fhir:description [ fhir:v "Rule: SMART Backend Services authorization — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-resource-consumer.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "rc-001 The SUT authenticates with a signed JWT client assertion (RFC 7523)" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rc-001 (input bindings and expected data). Covers security.smart-backend-services." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"POST\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should contain \"grant_type=client_credentials\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should contain \"client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should match \"client_assertion=[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+[.][A-Za-z0-9_-]+([&]|$)\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.body should contain \"scope=\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "ResourceProvider replies to ResourceConsumer with status 200 and:" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Patient lookup" ] ;
     fhir:description [ fhir:v "Rule: Patient lookup — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-resource-consumer.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "rc-002 The SUT searches Patient by the identifier parameter" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rc-002 (input bindings and expected data). Covers Patient.search-type, Patient.search.identifier." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"GET\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/Patient\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"identifier=\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.headers.Authorization should contain \"Bearer\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "ResourceProvider replies to ResourceConsumer with status 200 and:" ]
       ] )
     ] [
       fhir:name [ fhir:v "rc-003 The SUT reads the patient by logical id" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rc-003 (input bindings and expected data). Covers Patient.read." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"GET\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/Patient/otb-pat-1\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "ResourceProvider replies to ResourceConsumer with status 200 and:" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Search by patient" ] ;
     fhir:description [ fhir:v "Rule: Search by patient — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-resource-consumer.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "rc-004 The SUT searches Condition by the patient parameter" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rc-004 (input bindings and expected data). Covers Condition.search.patient." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"GET\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/Condition\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should match \"patient=(Patient(/|%2F))?otb-pat-1([&]|$)\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.headers.Authorization should contain \"Bearer\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "ResourceProvider replies to ResourceConsumer with status 200 and:" ]
       ] )
     ] [
       fhir:name [ fhir:v "rc-005 The SUT searches Observation by patient and category" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rc-005 (input bindings and expected data). Covers Observation.search.patient, Observation.search.category, Observation.search.code, Observation.search.date." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"GET\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/Observation\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should match \"patient=(Patient(/|%2F))?otb-pat-1([&]|$)\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"category=\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "ResourceProvider replies to ResourceConsumer with status 200 and:" ]
       ] )
     ] [
       fhir:name [ fhir:v "rc-006 The SUT searches AllergyIntolerance by the patient parameter" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rc-006 (input bindings and expected data). Covers AllergyIntolerance.search.patient." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.method should be \"GET\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should contain \"/AllergyIntolerance\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$received.path should match \"patient=(Patient(/|%2F))?otb-pat-1([&]|$)\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "ResourceProvider replies to ResourceConsumer with status 200 and:" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Transport security" ] ;
     fhir:description [ fhir:v "Rule: Transport security — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-resource-consumer.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "rc-007 TLS 1.2 or higher is used for all communications" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rc-007 (input bindings and expected data). Covers security.tls." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "TLS >= 1.2 — ResourceConsumer confirms each of these is accepted for \"the connection\"" ]
       ] )
     ] )
  ] ) . # 

