       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byIdentifier at \"Bundle.entry.resource.ofType(Patient).count() >= 1\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byIdentifier at \"Bundle.entry.resource.ofType(Patient).id.distinct().single()\" should be \"$patientId\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byId at \"Bundle.entry.resource.ofType(Patient).count() = 1\" should be true" ]
       ] )
     ] [
       fhir:name [ fhir:v "rap-006 Search Patient by the demographics the reference patient carries" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rap-006 (input bindings and expected data). Covers Patient.search.family, Patient.search.given, Patient.search.birthdate, Patient.search.gender, Patient.search.active." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "extract \"/name/0/family\" from $response.body as $family" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "extract \"/gender\" from $response.body as $gender" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "extract \"/birthDate\" from $response.body as $birthdate" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byFamily at \"Bundle.entry.resource.ofType(Patient).exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byFamily at \"Bundle.entry.resource.ofType(Patient).id.join(',')\" should contain $patientId" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byGender at \"Bundle.entry.resource.ofType(Patient).exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byGender at \"Bundle.entry.resource.ofType(Patient).id.join(',')\" should contain $patientId" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byBirth at \"Bundle.entry.resource.ofType(Patient).exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$byBirth at \"Bundle.entry.resource.ofType(Patient).id.join(',')\" should contain $patientId" ]
       ] [
