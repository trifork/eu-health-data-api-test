       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 401" ]
       ] )
     ] [
       fhir:name [ fhir:v "rap-003 A token with no usable scope is refused" ] ;
