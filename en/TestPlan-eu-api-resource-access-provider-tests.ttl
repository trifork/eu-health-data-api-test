     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "rap-001 The CapabilityStatement declares Patient read and search and SMART security" ] ;
       fhir:description [ fhir:v "Fixture contract: fixtures/provider-v1/manifest.json, cases.rap-001 (input bindings and expected data). Covers CapabilityStatement.rest.resource.Patient." ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be 200" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$capability at \"CapabilityStatement.rest.where(mode='server').resource.where(type='Patient').interaction.where(code='read').exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$capability at \"CapabilityStatement.rest.where(mode='server').resource.where(type='Patient').interaction.where(code='search-type').exists()\" should be true" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$capability at \"CapabilityStatement.rest.where(mode='server').security.service.coding.where(code='SMART-on-FHIR').exists()\" should be true" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "Authorization is required" ] ;
     fhir:description [ fhir:v "Rule: Authorization is required — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "eu-api-resource-access-provider.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "rap-002 A request without a token is refused" ] ;
